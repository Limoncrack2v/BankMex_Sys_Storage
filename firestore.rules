rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {
      allow create: if request.auth != null && request.resource.data.authUid == request.auth.uid;
      allow read: if request.auth != null && resource.data.authUid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.authUid && request.resource.data.authUid == resource.data.authUid;

      match /pantryItems/{pantryItemId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/families/$(familyId)).data.authUid == request.auth.uid;
      }
    }
    match /users/{userId} {
      allow create: if request.auth != null && (
        userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff"
      );
      allow read: if request.auth != null && userId == request.auth.uid
    }
  }
}