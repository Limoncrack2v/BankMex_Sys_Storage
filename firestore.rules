rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }

    function isNutritionist() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "nutritionist";
    }

    function isFamilyOwner(familyId) {
      return request.auth != null
        && get(/databases/$(database)/documents/families/$(familyId)).data.authUid == request.auth.uid;
    }

    function canAccessFamily(familyId) {
      return isFamilyOwner(familyId)
        || (isStaff() && exists(/databases/$(database)/documents/families/$(familyId)));
    }

    // Acciones sensibles del staff (crear cuentas, revisar solicitudes,
    // publicar recetas, cancelar o reasignar entregas): la sesión se inició
    // hace menos de 5 minutos (MASVS-AUTH-3). auth_time viene en segundos y
    // renovar el token no lo cambia: solo un inicio de sesión o una
    // reautenticación con contraseña lo actualiza.
    function recentlySignedIn() {
      return request.auth != null
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(5, 'm');
    }

    // nextDeliveryDate solo lo escribe la Cloud Function syncNextDelivery;
    // aquí se acepta porque validFamily revisa el documento completo, 
    // y abajo se impide que un cliente lo cree o lo cambie.
    function validFamily(data) {
      return data.keys().hasOnly(['name', 'address', 'registrationDate', 'recoveryQuotaDefault', 'authUid', 'appliances', 'nextDeliveryDate'])
        && data.keys().hasAll(['address', 'registrationDate', 'authUid', 'appliances'])
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 100))
        && data.address is string && data.address.size() <= 200
        && data.registrationDate is timestamp
        && (!('recoveryQuotaDefault' in data) || data.recoveryQuotaDefault == null
          || (data.recoveryQuotaDefault is number && data.recoveryQuotaDefault >= 0))
        && data.authUid is string && data.authUid.size() > 0
        && data.appliances is list
        && data.appliances.hasOnly(['estufa', 'refrigerador', 'horno', 'microondas', 'licuadora', 'ollaPresion'])
        && data.appliances.toSet().size() == data.appliances.size()
        && (!('nextDeliveryDate' in data) || data.nextDeliveryDate is timestamp);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.role in ['staff', 'family', 'nutritionist']
        && data.createdAt is timestamp;
    }

    function validMember(data) {
      return data.keys().hasOnly(['name', 'memberType', 'createdAt', 'age', 'weightKg', 'sex', 'allergies', 'chronicConditions'])
        && data.keys().hasAll(['name', 'memberType', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.memberType in ['adult', 'child']
        && data.createdAt is timestamp
        && (!('age' in data) || (data.age is int && data.age >= 0 && data.age <= 120))
        && (!('weightKg' in data) || (data.weightKg is number && data.weightKg > 0 && data.weightKg <= 500))
        && (!('sex' in data) || data.sex in ['male', 'female'])
        && (!('allergies' in data) || (data.allergies is list
          && data.allergies.size() <= 6
          && data.allergies.hasOnly(['dairy', 'gluten', 'peanut', 'shellfish', 'egg', 'soy'])
          && data.allergies.toSet().size() == data.allergies.size()))
        && (!('chronicConditions' in data) || (data.chronicConditions is list
          && data.chronicConditions.size() <= 5
          && data.chronicConditions.hasOnly(['diabetes', 'hypertension', 'obesity', 'kidneyDisease', 'highCholesterol'])
          && data.chronicConditions.toSet().size() == data.chronicConditions.size()));
    }

    function validStaffRequest(data) {
      return data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && data.keys().hasAll(['name', 'email', 'status', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.status == 'pending'
        && data.createdAt is timestamp;
    }

    // La entrega nueva de una reasignación: misma fecha, despensas y productos
    // que la original, para otra familia, programada y ligada a la original.
    function validReassignment(originalId, newId, original) {
      let next = getAfter(/databases/$(database)/documents/deliveries/$(newId)).data;
      return next.reassignedFrom == originalId
        && next.status == 'scheduled'
        && next.familyId != original.familyId
        && next.deliveryDate == original.deliveryDate
        && next.packages == original.packages
        && next.items == original.items;
    }

    // Trazabilidad offline: requerida en cada escritura. Los documentos viejos
    // sin estampa se validan hasta que se vuelven a escribir.
    function validTrace(data) {
      return (data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64)
        && (data.localTimestamp is timestamp && data.localTimestamp <= request.time + duration.value(5, 'm'));
    }

    // Un producto de una entrega (DeliveryItem.toMap), con los mismos límites
    // que DeliveryItem.validate y invalidReason (functions/pantry.js), salvo
    // el tope de la cantidad (PantryItem.maxQuantity): no cabe en el
    // presupuesto de expresiones de una reasignación con cuota y
    // justificación, y lo siguen aplicando DeliveryItem.validate e
    // invalidReason, que no deja pasar a la despensa un producto que lo
    // exceda. Si falta un campo o no tiene el tipo esperado, la evaluación
    // falla y la escritura se rechaza. type y unit son los valores de
    // FoodType y FoodUnit (lib/data/models/pantry_item.dart) y de FOOD_TYPES y
    // FOOD_UNITS (functions/pantry.js); se revisan juntos como "tipo/unidad"
    // para gastar menos expresiones.
    function validDeliveryItem(item) {
      return item.productId.matches('(?s).{1,100}')
        && (item.type + '/' + item.unit).matches('(grain|legume|canned|dairy|produce|protein|beverage|other)/(kg|g|l|ml|piece|can|pack)')
        && item.quantity > 0
        && item.expirationDate is timestamp;
    }

    // Las reglas no tienen ciclos ni recursión: cada producto se revisa por su
    // índice, y el producto k solo se evalúa si hay más de k (dentro de la
    // guarda del anterior). Cada solicitud tiene un tope de expresiones
    // (1000), y cada producto gasta unas 60: por eso el máximo es 16, igual
    // que Delivery.maxItems. El margen es corto: medido en el emulador caben
    // 11 condiciones triviales más en validDelivery, unos 1.5 productos. No
    // solo subir el tope: cualquier condición nueva en la creación o en la
    // reasignación de una entrega obliga a repetir las pruebas del máximo en
    // test_emulator/rules_deliveries_test.dart (grupo 'cantidad máxima de
    // productos' y las pruebas 'se reasigna una entrega con el máximo de
    // productos' y 'se reasigna el máximo con cuota y justificación').
    function validDeliveryItems(items) {
      let n = items.size();
      return items is list && n >= 1 && n <= 16
        && validDeliveryItem(items[0])
        && (n <= 1 || validDeliveryItem(items[1])
          && (n <= 2 || validDeliveryItem(items[2])
            && (n <= 3 || validDeliveryItem(items[3])
              && (n <= 4 || validDeliveryItem(items[4])
                && (n <= 5 || validDeliveryItem(items[5])
                  && (n <= 6 || validDeliveryItem(items[6])
                    && (n <= 7 || validDeliveryItem(items[7])
                      && (n <= 8 || validDeliveryItem(items[8])
                        && (n <= 9 || validDeliveryItem(items[9])
                          && (n <= 10 || validDeliveryItem(items[10])
                            && (n <= 11 || validDeliveryItem(items[11])
                              && (n <= 12 || validDeliveryItem(items[12])
                                && (n <= 13 || validDeliveryItem(items[13])
                                  && (n <= 14 || validDeliveryItem(items[14])
                                    && (n <= 15 || validDeliveryItem(items[15]))))))))))))))));
    }

    function validDelivery(data) {
      return data.keys().hasOnly(['familyId', 'familyName', 'deliveryDate', 'packages', 'recoveryFee', 'justification', 'status', 'notes', 'items', 'createdAt', 'reassignedFrom', 'deviceId', 'localTimestamp'])
        && data.keys().hasAll(['familyId', 'familyName', 'deliveryDate', 'packages', 'status', 'items', 'createdAt', 'deviceId', 'localTimestamp'])
        && data.familyId is string
        && exists(/databases/$(database)/documents/families/$(data.familyId))
        && data.familyName is string && data.familyName.size() <= 100
        && data.deliveryDate is timestamp
        && data.packages is int && data.packages >= 1 && data.packages <= 100
        && (!('recoveryFee' in data) || (data.recoveryFee is number && data.recoveryFee >= 0 && data.recoveryFee <= 100000))
        && (!('justification' in data) || (data.justification is string && data.justification.size() <= 500))
        // Con cuota (no exenta) la justificación es obligatoria, para auditoría.
        && (!('recoveryFee' in data) || ('justification' in data && data.justification.trim().size() > 0))
        && data.status in ['scheduled', 'delivered', 'cancelled']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && validDeliveryItems(data.items)
        && data.createdAt is timestamp
        && (!('reassignedFrom' in data) || (data.reassignedFrom is string
          && data.reassignedFrom.size() > 0 && data.reassignedFrom.size() <= 128))
        && validTrace(data);
    }

    // Una comida de un plan (MealPlanMeal.toMap), con los mismos límites que
    // MealPlanMeal.validate: ningún campo fuera de date, recipeId y servings;
    // la fecha dentro del rango del plan (extremos incluidos); recipeId de 1 a
    // 128 caracteres sin "/" (es el id de un documento de recipes; mismo tope
    // que reassignedFrom); y porciones mayores a 0 y de hasta 100 (el mismo
    // tope que los paquetes de una entrega). No hay hasAll ni "is timestamp",
    // "is string" o "is number" para gastar menos expresiones: leer un campo
    // que falta, o compararlo o aplicarle matches con otro tipo, falla la
    // evaluación y la escritura se rechaza. Si la comida no es un mapa,
    // hasOnly también falla.
    function validMeal(meal, start, end) {
      return meal.keys().hasOnly(['date', 'recipeId', 'servings'])
        && meal.date >= start && meal.date <= end
        && meal.recipeId.matches('[^/]{1,128}')
        && meal.servings > 0 && meal.servings <= 100;
    }

    // Las reglas no tienen ciclos ni recursión: cada comida se revisa por su
    // índice, y la comida k solo se evalúa si hay más de k (dentro de la
    // guarda de la anterior). Un plan abarca 7 o 14 días con una comida por
    // día (MealPlanLength, MealPlanGenerator): el máximo es 14, igual que
    // MealPlan.maxMeals. Cada solicitud tiene un tope de expresiones (1000).
    // El margen es corto: medido en el emulador, con 14 comidas caben 28
    // condiciones triviales (1 == 1) más en validMealPlan cuando el staff
    // cambia un plan (la ruta más cara) y fallan 30; al crear, caben 30 y
    // fallan 32. No solo subir el tope: cualquier condición nueva en validMeal
    // o en validMealPlan obliga a repetir las pruebas del máximo en
    // test_emulator/rules_meal_plans_test.dart (grupo 'cantidad máxima de
    // comidas').
    function validMeals(meals, start, end) {
      let n = meals.size();
      return meals is list && n <= 14
        && (n == 0 || validMeal(meals[0], start, end)
          && (n <= 1 || validMeal(meals[1], start, end)
            && (n <= 2 || validMeal(meals[2], start, end)
              && (n <= 3 || validMeal(meals[3], start, end)
                && (n <= 4 || validMeal(meals[4], start, end)
                  && (n <= 5 || validMeal(meals[5], start, end)
                    && (n <= 6 || validMeal(meals[6], start, end)
                      && (n <= 7 || validMeal(meals[7], start, end)
                        && (n <= 8 || validMeal(meals[8], start, end)
                          && (n <= 9 || validMeal(meals[9], start, end)
                            && (n <= 10 || validMeal(meals[10], start, end)
                              && (n <= 11 || validMeal(meals[11], start, end)
                                && (n <= 12 || validMeal(meals[12], start, end)
                                  && (n <= 13 || validMeal(meals[13], start, end)))))))))))))));
    }

    function validMealPlan(data) {
      return data.keys().hasOnly(['familyId', 'dateRangeStart', 'dateRangeEnd', 'meals'])
        && data.keys().hasAll(['familyId', 'dateRangeStart', 'dateRangeEnd', 'meals'])
        && data.familyId is path
        && data.familyId == /databases/$(database)/documents/families/$(data.familyId[4])
        && data.dateRangeStart is timestamp
        && data.dateRangeEnd is timestamp
        && data.dateRangeEnd >= data.dateRangeStart
        && validMeals(data.meals, data.dateRangeStart, data.dateRangeEnd);
    }

    // Un ingrediente de una receta (RecipeIngredient.toMap). unit es un valor
    // de FoodUnit (lib/data/models/pantry_item.dart). Si falta un campo o no
    // tiene el tipo esperado, la evaluación falla y la escritura se rechaza.
    // No se revisan campos de más dentro del ingrediente: cada comprobación
    // gasta expresiones y la app los ignora.
    function validRecipeIngredient(item) {
      return item.productName.matches('(?s).{1,100}')
        && item.quantity > 0 && item.quantity <= 1000000
        && item.unit.matches('kg|g|l|ml|piece|can|pack');
    }

    // Las reglas no tienen ciclos: cada ingrediente y cada paso se revisa por
    // su índice, y el k solo se evalúa si hay más de k. Por eso hay un máximo
    // (RecipeCatalog.maxIngredients y maxSteps): pasarlo rechaza la receta.
    // Una solicitud tiene un tope de 1000 expresiones y con estos máximos una
    // receta usa casi todas. Si se sube alguno, repetir las pruebas de máximos
    // de test_emulator/rules_recipe_validation_test.dart.
    function validRecipeIngredients(items) {
      let n = items.size();
      return items is list && n >= 1 && n <= 10
        && (n <= 0 || validRecipeIngredient(items[0]))
        && (n <= 1 || validRecipeIngredient(items[1]))
        && (n <= 2 || validRecipeIngredient(items[2]))
        && (n <= 3 || validRecipeIngredient(items[3]))
        && (n <= 4 || validRecipeIngredient(items[4]))
        && (n <= 5 || validRecipeIngredient(items[5]))
        && (n <= 6 || validRecipeIngredient(items[6]))
        && (n <= 7 || validRecipeIngredient(items[7]))
        && (n <= 8 || validRecipeIngredient(items[8]))
        && (n <= 9 || validRecipeIngredient(items[9]));
    }

    function validRecipeSteps(steps) {
      let n = steps.size();
      return steps is list && n >= 1 && n <= 12
        && (n <= 0 || steps[0].matches('(?s).{1,300}'))
        && (n <= 1 || steps[1].matches('(?s).{1,300}'))
        && (n <= 2 || steps[2].matches('(?s).{1,300}'))
        && (n <= 3 || steps[3].matches('(?s).{1,300}'))
        && (n <= 4 || steps[4].matches('(?s).{1,300}'))
        && (n <= 5 || steps[5].matches('(?s).{1,300}'))
        && (n <= 6 || steps[6].matches('(?s).{1,300}'))
        && (n <= 7 || steps[7].matches('(?s).{1,300}'))
        && (n <= 8 || steps[8].matches('(?s).{1,300}'))
        && (n <= 9 || steps[9].matches('(?s).{1,300}'))
        && (n <= 10 || steps[10].matches('(?s).{1,300}'))
        && (n <= 11 || steps[11].matches('(?s).{1,300}'));
    }

    // Las etiquetas libres solo se cuentan: revisar cada una gasta
    // expresiones que las demás partes de la receta necesitan.
    function validDietaryTags(tags) {
      return tags is list && tags.size() <= 10;
    }

    // Etiquetas y electrodomésticos: los de NutritionalTag y Appliance
    // (lib/domain/models). Al editar se aceptan también los ids que la receta
    // ya tenía, para no borrar los de una versión más nueva de la app
    // (RecipeCatalog.validateTags hace lo mismo).
    function validRecipeTags(tags, known, stored) {
      return tags is list && tags.size() <= 20
        && tags.hasOnly(known.concat(stored))
        && tags.toSet().size() == tags.size();
    }

    // before es el documento guardado al editar, o {} al crear. La receta
    // completa debe ser válida: el catálogo escribe todos los campos siempre
    // (Recipe.toMap). Los campos de revisión (approvedBy, approvedAt,
    // reviewNote, rejectedBy y rejectedAt) los escribe solo el nutriólogo,
    // por eso solo se aceptan aquí y los controlan las reglas de recipes.
    function validRecipe(data, before) {
      return data.keys().hasOnly(['name', 'ingredients', 'steps', 'prepTimeMinutes', 'caloriesPerServing', 'status', 'dietaryTags', 'nutritionalTags', 'requiredEquipment', 'image', 'servings', 'approvedBy', 'approvedAt', 'reviewNote', 'rejectedBy', 'rejectedAt'])
        && data.keys().hasAll(['name', 'ingredients', 'steps', 'prepTimeMinutes', 'caloriesPerServing', 'status', 'dietaryTags', 'nutritionalTags', 'requiredEquipment', 'image', 'servings'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.status in ['draft', 'pending', 'approved']
        && data.prepTimeMinutes is int && data.prepTimeMinutes >= 1 && data.prepTimeMinutes <= 9999
        && data.caloriesPerServing is int && data.caloriesPerServing >= 0 && data.caloriesPerServing <= 5000
        && data.servings is int && data.servings >= 1 && data.servings <= 99
        && data.image is string && data.image.size() <= 300
        && validRecipeIngredients(data.ingredients)
        && validRecipeSteps(data.steps)
        && validDietaryTags(data.dietaryTags)
        && validRecipeTags(data.nutritionalTags,
          ['bajoEnSodio', 'bajoEnAzucar', 'bajoEnGrasa', 'altoEnFibra', 'altoEnProteina', 'vegetariano', 'aptoDiabeticos'],
          before.get('nutritionalTags', []))
        && validRecipeTags(data.requiredEquipment,
          ['estufa', 'refrigerador', 'horno', 'microondas', 'licuadora', 'ollaPresion'],
          before.get('requiredEquipment', []));
    }

    // Lo que Staff deja en una receta que guarda: nada de lo que escribe el
    // nutriólogo. No queda quién la aprobó, y el motivo de un rechazo solo
    // sigue mientras la receta sea draft; al reenviarla a pending se borra.
    function staffKeepsReview(data, before) {
      return !('approvedBy' in data) && !('approvedAt' in data)
        && (data.status == 'draft'
          ? (data.get('reviewNote', null) == before.get('reviewNote', null)
            && data.get('rejectedBy', null) == before.get('rejectedBy', null)
            && data.get('rejectedAt', null) == before.get('rejectedAt', null))
          : (!('reviewNote' in data) && !('rejectedBy' in data) && !('rejectedAt' in data)));
    }

    // El nutriólogo aprueba una pending: cambian solo status y quién la
    // aprobó y cuándo.
    function nutritionistApproves(data, before) {
      return before.status == 'pending' && data.status == 'approved'
        && data.diff(before).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt'])
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time;
    }

    // El nutriólogo rechaza una pending: regresa a draft y cambian solo
    // status, el motivo (obligatorio) y quién la rechazó y cuándo.
    function nutritionistRejects(data, before) {
      return before.status == 'pending' && data.status == 'draft'
        && data.diff(before).affectedKeys().hasOnly(['status', 'reviewNote', 'rejectedBy', 'rejectedAt'])
        && data.reviewNote is string
        && data.reviewNote.trim().size() >= 1 && data.reviewNote.size() <= 300
        && data.rejectedBy == request.auth.uid
        && data.rejectedAt == request.time;
    }

    // Un registro de consumo (PantryRepository.consumptionLog). at puede venir
    // de un dispositivo sin conexión, así que solo se limita hacia el futuro,
    // igual que localTimestamp en validTrace.
    function validConsumptionLog(data) {
      return data.keys().hasOnly(['productId', 'quantity', 'unit', 'category', 'at', 'deviceId', 'reason'])
        && data.keys().hasAll(['productId', 'quantity', 'unit', 'category', 'at', 'deviceId', 'reason'])
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 100
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
        && data.unit in ['kg', 'g', 'l', 'ml', 'piece', 'can', 'pack']
        && data.category in ['grain', 'legume', 'canned', 'dairy', 'produce', 'protein', 'beverage', 'other']
        && data.at is timestamp && data.at <= request.time + duration.value(5, 'm')
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64
        && data.reason in ['consumed', 'expired'];
    }

    // Un cambio de una adaptación (AdjustmentChange.toMap): su tipo y el motivo
    // que ve el nutriólogo; en una sustitución, también el ingrediente que se
    // cambia y el que lo reemplaza.
    function validAdjustmentChange(change) {
      return change.kind in ['portions', 'substitution']
        && change.reason.matches('(?s).{1,200}')
        && (!('from' in change) || change.from.matches('(?s).{1,100}'))
        && (!('to' in change) || change.to.matches('(?s).{1,100}'));
    }

    // Igual que los ingredientes de una receta: cada cambio se revisa por su
    // índice, así que hay un máximo (AdjustmentChange.maxPerSuggestion).
    function validAdjustmentChanges(changes) {
      let n = changes.size();
      return changes is list && n >= 1 && n <= 6
        && (n <= 0 || validAdjustmentChange(changes[0]))
        && (n <= 1 || validAdjustmentChange(changes[1]))
        && (n <= 2 || validAdjustmentChange(changes[2]))
        && (n <= 3 || validAdjustmentChange(changes[3]))
        && (n <= 4 || validAdjustmentChange(changes[4]))
        && (n <= 5 || validAdjustmentChange(changes[5]));
    }

    // Una adaptación al crearla (RecipeAdjustment.toMap): siempre pendiente y
    // sin datos de revisión. No lleva nombres de la familia ni de sus
    // integrantes: solo el tamaño del hogar y el motivo de cada cambio.
    // Los ingredientes se revisan como los de una receta.
    function validAdjustment(data) {
      return data.keys().hasOnly(['familyId', 'recipeId', 'baseSignature', 'householdSize', 'servings', 'ingredients', 'changes', 'summary', 'status', 'createdAt'])
        && data.keys().hasAll(['familyId', 'recipeId', 'baseSignature', 'householdSize', 'servings', 'ingredients', 'changes', 'summary', 'status', 'createdAt'])
        && data.familyId is path
        && data.familyId == /databases/$(database)/documents/families/$(data.familyId[4])
        && data.recipeId.matches('[^/]{1,128}')
        && data.baseSignature.matches('[0-9a-f]{8}')
        && data.householdSize is int && data.householdSize >= 1 && data.householdSize <= 50
        && data.servings is int && data.servings >= 1 && data.servings <= 99
        && data.summary.matches('(?s).{1,300}')
        && data.status == 'pending'
        && data.createdAt == request.time
        && validAdjustmentChanges(data.changes)
        && validRecipeIngredients(data.ingredients);
    }

    // El nutriólogo decide una pending: solo cambian status y quién la revisó y
    // cuándo, y un rechazo lleva su motivo.
    function nutritionistReviewsAdjustment(data, before) {
      return before.status == 'pending'
        && data.reviewedBy == request.auth.uid
        && data.reviewedAt == request.time
        && ((data.status == 'approved'
            && data.diff(before).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']))
          || (data.status == 'rejected'
            && data.diff(before).affectedKeys().hasOnly(['status', 'rejectionReason', 'reviewedBy', 'reviewedAt'])
            && data.rejectionReason is string
            && data.rejectionReason.trim().size() >= 1 && data.rejectionReason.size() <= 300));
    }

    match /families/{familyId} {
      // Solo el staff registra familias, junto con su perfil users/{authUid}
      // (mismo batch). El id del hogar es el uid de su cuenta: un hogar por
      // cuenta.
      allow create: if isStaff()
        && recentlySignedIn()
        && validFamily(request.resource.data)
        && familyId == request.resource.data.authUid
        && getAfter(/databases/$(database)/documents/users/$(familyId)).data.role == 'family'
        && !('nextDeliveryDate' in request.resource.data);
      allow read: if request.auth != null && (resource.data.authUid == request.auth.uid || isStaff());
      // La familia solo puede cambiar sus electrodomésticos; el staff corrige
      // los demás datos sin cambiar la cuenta dueña.
      allow update: if request.auth != null
        && request.resource.data.authUid == resource.data.authUid
        && validFamily(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nextDeliveryDate'])
        && (isStaff()
          || (request.auth.uid == resource.data.authUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliances'])));
      allow delete: if isStaff();

      // Ningún cliente, incluido el staff, crea productos en la despensa: solo
      // la Cloud Function onDeliveryWritten (functions/index.js), con el Admin
      // SDK, los crea cuando una entrega queda confirmada.
      match /pantryItems/{pantryItemId} {
        allow create: if false;
        allow read, delete: if canAccessFamily(familyId);
        // Registrar consumo: solo baja la cantidad (sin llegar a 0; en ese
        // caso se borra) y ningún otro campo cambia.
        allow update: if canAccessFamily(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.quantity < resource.data.quantity;
      }

      // Los integrantes guardan datos de salud (edad, peso, sexo, alergias y
      // enfermedades crónicas). Solo la familia dueña los lee y los escribe:
      // la familia los agrega desde su perfil y ninguna pantalla de staff los
      // usa (MASVS-PRIVACY-1).
      match /members/{memberId} {
        allow read, delete: if isFamilyOwner(familyId);
        allow create: if isFamilyOwner(familyId) && validMember(request.resource.data);
        allow update: if isFamilyOwner(familyId)
          && validMember(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Solo se agregan: ningún flujo de la app edita o borra un registro, y
      // las estadísticas de consumo y desperdicio cuentan con ellos.
      match /consumptionLogs/{logId} {
        allow read: if canAccessFamily(familyId);
        allow create: if canAccessFamily(familyId)
          && validConsumptionLog(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Entregas registradas por el staff. Cuando una queda como entregada, la
    // Cloud Function onDeliveryWritten agrega sus productos a
    // families/{familyId}/pantryItems y la marca con pantryStockedAt.
    match /deliveries/{deliveryId} {
      allow read: if isStaff();
      // Una entrega que viene de una reasignación (reassignedFrom) solo se
      // crea en el mismo batch que marca la original como reasignada.
      allow create: if isStaff()
        && validDelivery(request.resource.data)
        && request.resource.data.status in ['scheduled', 'delivered']
        && (!('reassignedFrom' in request.resource.data)
          || (request.resource.data.status == 'scheduled'
            && getAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.reassignedFrom)).data.status == 'reassigned'
            && getAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.reassignedFrom)).data.reassignedTo == deliveryId));
      // Una entrega programada solo cambia de estado una vez: a entregada, a
      // cancelada o a reasignada (con la entrega nueva para otra familia en el
      // mismo batch). Así no se puede marcar como entregada dos veces desde
      // dos dispositivos y duplicar los productos en la despensa.
      // Cancelar y reasignar piden una sesión reciente. Marcar como entregada
      // no: la entrega se hace sin conexión, y una escritura en cola que se
      // sincroniza más de 5 minutos después de iniciar sesión se rechazaría
      // y la despensa nunca se llenaría.
      allow update: if isStaff()
        && (request.resource.data.status == 'delivered' || recentlySignedIn())
        && resource.data.status == 'scheduled'
        && validTrace(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['localTimestamp'])
        && ((request.resource.data.status in ['delivered', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deviceId', 'localTimestamp']))
          || (request.resource.data.status == 'reassigned'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reassignedTo', 'deviceId', 'localTimestamp'])
            && request.resource.data.reassignedTo is string
            && validReassignment(deliveryId, request.resource.data.reassignedTo, resource.data)));
    }

    // Solicitudes de cuenta de staff (pantalla "Registro de Staff"). La
    // persona crea su cuenta de Auth y su solicitud, pero no entra a la app
    // hasta que un staff la aprueba: aprobar crea su perfil users/{uid} con
    // rol staff en el mismo batch.
    match /staffRequests/{uid} {
      // Una cuenta que ya tiene perfil (familia o staff) no solicita nada: su
      // solicitud nunca se podría aprobar, porque users/{uid} no se actualiza.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validStaffRequest(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/users/$(uid));
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow update: if isStaff()
        && recentlySignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'rejected'
          || (request.resource.data.status == 'approved'
            && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'staff'));
    }

    // Contenido fijo de cada despensa del banco. Solo lo escriben los scripts
    // de tool/ (standard_baskets.mjs) con credenciales de administrador; el
    // staff lo lee para llenar los productos de una entrega.
    match /standardBaskets/{basketId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /users/{userId} {
      // Solo el staff crea perfiles
      // (así nadie puede asignarse el rol staff o de nutriólogo).
      allow create: if isStaff()
        && recentlySignedIn()
        && validUserProfile(request.resource.data);
      allow read: if request.auth != null && userId == request.auth.uid;
    }

    // Catálogo global. Una receta es draft (Staff la prepara), pending (espera
    // al nutriólogo) o approved (las familias la ven). Staff crea, edita y
    // mueve entre draft y pending, y puede sacar una approved a draft o
    // pending (con o sin cambios), pero nunca guarda una como approved: solo
    // el nutriólogo la aprueba (pending a approved) o la rechaza (pending a
    // draft, con motivo), con un inicio de sesión reciente y sin cambiar su
    // contenido. Editar el contenido dejándola approved no lo puede hacer
    // nadie. La familia solo lee las approved y el nutriólogo solo las pending.
    match /recipes/{recipeId} {
      allow read: if isStaff()
        || (isNutritionist() && resource.data.status == 'pending')
        || (request.auth != null && resource.data.status == 'approved');
      allow create: if isStaff()
        && request.resource.data.status in ['draft', 'pending']
        && validRecipe(request.resource.data, {})
        && staffKeepsReview(request.resource.data, {});
      allow update: if (isStaff()
          && request.resource.data.status in ['draft', 'pending']
          && validRecipe(request.resource.data, resource.data)
          && staffKeepsReview(request.resource.data, resource.data))
        || (isNutritionist()
          && recentlySignedIn()
          && (nutritionistApproves(request.resource.data, resource.data)
            || nutritionistRejects(request.resource.data, resource.data)));
      allow delete: if isStaff();
    }

    // Adaptaciones de recetas para un hogar. La familia dueña crea la sugerencia
    // (solo de una receta aprobada, pendiente y sin revisión) y lee las suyas;
    // retira una que sigue pendiente. El nutriólogo las lee todas y las aprueba
    // o rechaza con un inicio de sesión reciente, sin cambiar su contenido.
    // Nadie más las lee ni las escribe, y nadie edita su contenido.
    match /adjustments/{adjustmentId} {
      allow read: if isNutritionist()
        || (request.auth != null && isFamilyOwner(resource.data.familyId[4]));
      // El id es uno por familia, receta, versión de la receta y tamaño del
      // hogar (RecipeAdjustment.documentId): una familia no puede llenar la
      // cola del nutriólogo, porque crear el mismo id otra vez es una
      // actualización y la familia no actualiza.
      allow create: if isFamilyOwner(request.resource.data.familyId[4])
        && validAdjustment(request.resource.data)
        && adjustmentId == request.resource.data.familyId[4] + '_'
          + request.resource.data.recipeId + '_'
          + request.resource.data.baseSignature + '_'
          + string(request.resource.data.householdSize)
        && get(/databases/$(database)/documents/recipes/$(request.resource.data.recipeId)).data.status == 'approved';
      allow update: if isNutritionist()
        && recentlySignedIn()
        && nutritionistReviewsAdjustment(request.resource.data, resource.data);
      allow delete: if isFamilyOwner(resource.data.familyId[4])
        && resource.data.status == 'pending';
    }

    // Solo la familia dueña del plan y el staff lo leen y lo escriben. Un plan
    // no cambia de familia.
    match /mealPlans/{planId} {
      // Un plan que no existe se lee como vacío (not found), no como error.
      allow get: if request.auth != null
        && (resource == null || canAccessFamily(resource.data.familyId[4]));
      allow list, delete: if canAccessFamily(resource.data.familyId[4]);
      allow create: if validMealPlan(request.resource.data)
        && canAccessFamily(request.resource.data.familyId[4]);
      allow update: if canAccessFamily(resource.data.familyId[4])
        && validMealPlan(request.resource.data)
        && request.resource.data.familyId == resource.data.familyId;
    }
  }
}
