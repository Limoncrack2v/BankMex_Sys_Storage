rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }

    function isFamilyOwner(familyId) {
      return request.auth != null
        && get(/databases/$(database)/documents/families/$(familyId)).data.authUid == request.auth.uid;
    }

    function canAccessFamily(familyId) {
      return isFamilyOwner(familyId)
        || (isStaff() && exists(/databases/$(database)/documents/families/$(familyId)));
    }

    // nextDeliveryDate solo lo escribe la Cloud Function syncNextDelivery;
    // aquí se acepta porque validFamily revisa el documento completo, 
    // y abajo se impide que un cliente lo cree o lo cambie.
    function validFamily(data) {
      return data.keys().hasOnly(['name', 'address', 'registrationDate', 'recoveryQuotaDefault', 'authUid', 'appliances', 'nextDeliveryDate'])
        && data.keys().hasAll(['address', 'registrationDate', 'authUid', 'appliances'])
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 100))
        && data.address is string && data.address.size() <= 200
        && data.registrationDate is timestamp
        && (!('recoveryQuotaDefault' in data) || data.recoveryQuotaDefault == null
          || (data.recoveryQuotaDefault is number && data.recoveryQuotaDefault >= 0))
        && data.authUid is string && data.authUid.size() > 0
        && data.appliances is list
        && data.appliances.hasOnly(['estufa', 'refrigerador', 'horno', 'microondas', 'licuadora', 'ollaPresion'])
        && data.appliances.toSet().size() == data.appliances.size()
        && (!('nextDeliveryDate' in data) || data.nextDeliveryDate is timestamp);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.role in ['staff', 'family']
        && data.createdAt is timestamp;
    }

    function validMember(data) {
      return data.keys().hasOnly(['name', 'memberType', 'createdAt', 'age', 'weightKg', 'sex', 'allergies', 'chronicConditions'])
        && data.keys().hasAll(['name', 'memberType', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.memberType in ['adult', 'child']
        && data.createdAt is timestamp
        && (!('age' in data) || (data.age is int && data.age >= 0 && data.age <= 120))
        && (!('weightKg' in data) || (data.weightKg is number && data.weightKg > 0 && data.weightKg <= 500))
        && (!('sex' in data) || data.sex in ['male', 'female'])
        && (!('allergies' in data) || (data.allergies is list
          && data.allergies.size() <= 6
          && data.allergies.hasOnly(['dairy', 'gluten', 'peanut', 'shellfish', 'egg', 'soy'])
          && data.allergies.toSet().size() == data.allergies.size()))
        && (!('chronicConditions' in data) || (data.chronicConditions is list
          && data.chronicConditions.size() <= 5
          && data.chronicConditions.hasOnly(['diabetes', 'hypertension', 'obesity', 'kidneyDisease', 'highCholesterol'])
          && data.chronicConditions.toSet().size() == data.chronicConditions.size()));
    }

    function validStaffRequest(data) {
      return data.keys().hasOnly(['name', 'email', 'status', 'createdAt'])
        && data.keys().hasAll(['name', 'email', 'status', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 254
        && data.status == 'pending'
        && data.createdAt is timestamp;
    }

    // La entrega nueva de una reasignación: misma fecha, despensas y productos
    // que la original, para otra familia, programada y ligada a la original.
    function validReassignment(originalId, newId, original) {
      let next = getAfter(/databases/$(database)/documents/deliveries/$(newId)).data;
      return next.reassignedFrom == originalId
        && next.status == 'scheduled'
        && next.familyId != original.familyId
        && next.deliveryDate == original.deliveryDate
        && next.packages == original.packages
        && next.items == original.items;
    }

    // Trazabilidad offline: requerida en cada escritura. Los documentos viejos
    // sin estampa se validan hasta que se vuelven a escribir.
    function validTrace(data) {
      return (data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64)
        && (data.localTimestamp is timestamp && data.localTimestamp <= request.time + duration.value(5, 'm'));
    }

    function validDelivery(data) {
      return data.keys().hasOnly(['familyId', 'familyName', 'deliveryDate', 'packages', 'recoveryFee', 'justification', 'status', 'notes', 'items', 'createdAt', 'reassignedFrom', 'deviceId', 'localTimestamp'])
        && data.keys().hasAll(['familyId', 'familyName', 'deliveryDate', 'packages', 'status', 'items', 'createdAt', 'deviceId', 'localTimestamp'])
        && data.familyId is string
        && exists(/databases/$(database)/documents/families/$(data.familyId))
        && data.familyName is string && data.familyName.size() <= 100
        && data.deliveryDate is timestamp
        && data.packages is int && data.packages >= 1 && data.packages <= 100
        && (!('recoveryFee' in data) || (data.recoveryFee is number && data.recoveryFee >= 0 && data.recoveryFee <= 100000))
        && (!('justification' in data) || (data.justification is string && data.justification.size() <= 500))
        && data.status in ['scheduled', 'delivered', 'cancelled']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && data.createdAt is timestamp
        && (!('reassignedFrom' in data) || (data.reassignedFrom is string
          && data.reassignedFrom.size() > 0 && data.reassignedFrom.size() <= 128))
        && validTrace(data);
    }

    function validMealPlan(data) {
      return data.keys().hasOnly(['familyId', 'dateRangeStart', 'dateRangeEnd', 'meals'])
        && data.keys().hasAll(['familyId', 'dateRangeStart', 'dateRangeEnd', 'meals'])
        && data.familyId is path
        && data.familyId == /databases/$(database)/documents/families/$(data.familyId[4])
        && data.dateRangeStart is timestamp
        && data.dateRangeEnd is timestamp
        && data.dateRangeEnd >= data.dateRangeStart
        && data.meals is list && data.meals.size() <= 100;
    }

    match /families/{familyId} {
      // Solo el staff registra familias, junto con su perfil users/{authUid}
      // (mismo batch). El id del hogar es el uid de su cuenta: un hogar por
      // cuenta.
      allow create: if isStaff()
        && validFamily(request.resource.data)
        && familyId == request.resource.data.authUid
        && getAfter(/databases/$(database)/documents/users/$(familyId)).data.role == 'family'
        && !('nextDeliveryDate' in request.resource.data);
      allow read: if request.auth != null && (resource.data.authUid == request.auth.uid || isStaff());
      // La familia solo puede cambiar sus electrodomésticos; el staff corrige
      // los demás datos sin cambiar la cuenta dueña.
      allow update: if request.auth != null
        && request.resource.data.authUid == resource.data.authUid
        && validFamily(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nextDeliveryDate'])
        && (isStaff()
          || (request.auth.uid == resource.data.authUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliances'])));
      allow delete: if isStaff();

      // Ningún cliente, incluido el staff, crea productos en la despensa: solo
      // la Cloud Function onDeliveryWritten (functions/index.js), con el Admin
      // SDK, los crea cuando una entrega queda confirmada.
      match /pantryItems/{pantryItemId} {
        allow create: if false;
        allow read, delete: if canAccessFamily(familyId);
        // Registrar consumo: solo baja la cantidad (sin llegar a 0; en ese
        // caso se borra) y ningún otro campo cambia.
        allow update: if canAccessFamily(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.quantity < resource.data.quantity;
      }

      // Los integrantes guardan datos de salud (edad, peso, sexo, alergias y
      // enfermedades crónicas). Solo la familia dueña los lee y los escribe:
      // la familia los agrega desde su perfil y ninguna pantalla de staff los
      // usa (MASVS-PRIVACY-1).
      match /members/{memberId} {
        allow read, delete: if isFamilyOwner(familyId);
        allow create: if isFamilyOwner(familyId) && validMember(request.resource.data);
        allow update: if isFamilyOwner(familyId)
          && validMember(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /consumptionLogs/{logId} {
        allow read, write: if canAccessFamily(familyId);
      }
    }

    // Entregas registradas por el staff. Cuando una queda como entregada, la
    // Cloud Function onDeliveryWritten agrega sus productos a
    // families/{familyId}/pantryItems y la marca con pantryStockedAt.
    match /deliveries/{deliveryId} {
      allow read: if isStaff();
      // Una entrega que viene de una reasignación (reassignedFrom) solo se
      // crea en el mismo batch que marca la original como reasignada.
      allow create: if isStaff()
        && validDelivery(request.resource.data)
        && request.resource.data.status in ['scheduled', 'delivered']
        && (!('reassignedFrom' in request.resource.data)
          || (request.resource.data.status == 'scheduled'
            && getAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.reassignedFrom)).data.status == 'reassigned'
            && getAfter(/databases/$(database)/documents/deliveries/$(request.resource.data.reassignedFrom)).data.reassignedTo == deliveryId));
      // Una entrega programada solo cambia de estado una vez: a entregada, a
      // cancelada o a reasignada (con la entrega nueva para otra familia en el
      // mismo batch). Así no se puede marcar como entregada dos veces desde
      // dos dispositivos y duplicar los productos en la despensa.
      allow update: if isStaff()
        && resource.data.status == 'scheduled'
        && validTrace(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['localTimestamp'])
        && ((request.resource.data.status in ['delivered', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deviceId', 'localTimestamp']))
          || (request.resource.data.status == 'reassigned'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reassignedTo', 'deviceId', 'localTimestamp'])
            && request.resource.data.reassignedTo is string
            && validReassignment(deliveryId, request.resource.data.reassignedTo, resource.data)));
    }

    // Solicitudes de cuenta de staff (pantalla "Registro de Staff"). La
    // persona crea su cuenta de Auth y su solicitud, pero no entra a la app
    // hasta que un staff la aprueba: aprobar crea su perfil users/{uid} con
    // rol staff en el mismo batch.
    match /staffRequests/{uid} {
      // Una cuenta que ya tiene perfil (familia o staff) no solicita nada: su
      // solicitud nunca se podría aprobar, porque users/{uid} no se actualiza.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validStaffRequest(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && !exists(/databases/$(database)/documents/users/$(uid));
      allow read: if request.auth != null && (request.auth.uid == uid || isStaff());
      allow update: if isStaff()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'rejected'
          || (request.resource.data.status == 'approved'
            && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'staff'));
    }

    // Contenido fijo de cada despensa del banco. Solo lo escriben los scripts
    // de tool/ (standard_baskets.mjs) con credenciales de administrador; el
    // staff lo lee para llenar los productos de una entrega.
    match /standardBaskets/{basketId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /users/{userId} {
      // Solo el staff crea perfiles (así nadie puede asignarse el rol staff).
      allow create: if isStaff() && validUserProfile(request.resource.data);
      allow read: if request.auth != null && userId == request.auth.uid;
    }

    // Catálogo global. El staff publica y edita; la familia solo lee approved.
    match /recipes/{recipeId} {
      allow read: if isStaff()
        || (request.auth != null && resource.data.status == 'approved');
      allow create, update, delete: if isStaff();
    }

    // Solo la familia dueña del plan y el staff lo leen y lo escriben. Un plan
    // no cambia de familia.
    match /mealPlans/{planId} {
      // Un plan que no existe se lee como vacío (not found), no como error.
      allow get: if request.auth != null
        && (resource == null || canAccessFamily(resource.data.familyId[4]));
      allow list, delete: if canAccessFamily(resource.data.familyId[4]);
      allow create: if validMealPlan(request.resource.data)
        && canAccessFamily(request.resource.data.familyId[4]);
      allow update: if canAccessFamily(resource.data.familyId[4])
        && validMealPlan(request.resource.data)
        && request.resource.data.familyId == resource.data.familyId;
    }
  }
}
